# Optional overrides for local operation. The default setup (till, backend,
# and dashboard all on the same computer) needs none of this — it just
# works out of the box. These only matter if you're running the till on a
# separate device (e.g. a tablet) that reaches the backend over the shop's
# WiFi instead of localhost. Not auto-loaded (no dotenv dependency); export
# these yourself before starting the backend if you need them, e.g.:
#   export ALLOWED_ORIGINS=http://192.168.1.50:5173
#   uvicorn main:app --host 0.0.0.0 --port 8000

# Comma-separated list of browser origins allowed to call the backend API.
# Only needed if the till app is served from a different device than the
# backend — point it at that device's origin (its LAN IP and port).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The backend's own address, used by the dashboard to build a URL for a
# manager-uploaded item photo. Only needed if the dashboard runs on a
# different device than the backend — point it at the backend's LAN IP.
PUBLIC_BACKEND_URL=http://localhost:8000

# Signs till API session tokens. Optional — if unset, a random key is
# generated once and saved to backend/.secret_key on first run, which is
# fine for a single always-on shop computer. Only set this yourself if you
# want the key to be portable across a fresh install.
# SECRET_KEY=
