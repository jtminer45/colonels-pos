# Copy to .env for local development (never commit the real .env).
# On Render, these are set as real environment variables in each service's
# dashboard/render.yaml — Render does not read this file.

# Postgres connection string. Render injects this automatically for
# services with the database attached; for local dev, point at a local
# Postgres instance.
DATABASE_URL=postgresql://colonels_pos:colonels_pos@localhost:5432/colonels_pos

# Comma-separated list of browser origins allowed to call the backend API.
# Include the till app's dev server and, once deployed, its Netlify URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
