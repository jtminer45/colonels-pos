# Python
venv/
__pycache__/
*.pyc

# Local SQLite database — real shop data (sales, staff accounts, password
# hashes), never committed. WAL-mode sidecar files included.
database/*.db
database/*.db-wal
database/*.db-shm

# Backend secrets
backend/.secret_key
.env
till-app/.env
till-app/.env.production

# Node / till-app
till-app/node_modules/
till-app/dist/
till-app/dev-dist/

# Streamlit
dashboard/.streamlit/secrets.toml

# OS
.DS_Store

# Local Netlify folder
.netlify
till-app/tsconfig.tsbuildinfo
till-app/vite.config.js
till-app/vite.config.d.ts
till-app/tsconfig.node.tsbuildinfo

# Raw uploaded menu/logo photos dropped directly in assets/ — only the
# processed, slugified copies in assets/menu_photos/ are actually used by
# the apps and committed; these originals are reference material only.
assets/*.jpeg
assets/*.jpg
assets/*.webp
